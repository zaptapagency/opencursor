# opencursor Cloud — environment variables
#
# Copy to `.env.local` for local development (gitignored). In production these
# are set in Railway's service Variables UI — never commit real secrets.
#
# Only the variables marked [Phase A] are read by the app today. The rest are
# documented here so Railway can be provisioned ahead of each phase; each var is
# added to `src/lib/env.ts` (and becomes required) when its phase lands.

# ---------------------------------------------------------------------------
# [Phase A] Core
# ---------------------------------------------------------------------------

# PostgreSQL connection string. On Railway, add the Postgres plugin and
# reference its DATABASE_URL. Locally, point at a local/Docker Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/opencursor"

# Public base URL of this app (used for metadata/OG and, later, auth callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment. Railway sets this to "production" automatically.
NODE_ENV="development"

# ---------------------------------------------------------------------------
# [Phase B] Auth.js (NextAuth v5) — Google OAuth + email magic link
# ---------------------------------------------------------------------------

# `openssl rand -base64 32`
AUTH_SECRET=""
# Public URL Auth.js uses for callbacks (usually same as NEXT_PUBLIC_APP_URL).
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# [Phase B] Transactional email (Resend) — magic links & receipts
# ---------------------------------------------------------------------------

RESEND_API_KEY=""
EMAIL_FROM="opencursor <noreply@example.com>"

# ---------------------------------------------------------------------------
# [Phase C] Licensing
# ---------------------------------------------------------------------------

# Server-side pepper for HMAC-hashing license keys before storage. Long random
# string; rotating it invalidates all existing license hashes.
LICENSE_KEY_PEPPER=""

# ---------------------------------------------------------------------------
# [Phase D] Stripe billing
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_ANNUAL=""

# ---------------------------------------------------------------------------
# [Phase F] Admin
# ---------------------------------------------------------------------------

# Comma-separated list of admin email addresses allowed to reach /admin.
ADMIN_EMAILS=""
