{
  "name": "opencursor-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "opencursor Cloud — accounts, licensing, and billing for the opencursor VS Code extension.",
  "license": "MIT",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
